{
  "name": "sistema-calificaciones",
  "version": "1.0.0",
  "description": "API de gestión de calificaciones con roles (admin, docente, alumno)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "test": "jest",
    "test:cobertura": "jest --coverage",
    "probar": "node scripts/probar-api.js"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/domain/**/*.js",
      "src/use-cases/**/*.js",
      "src/controllers/**/*.js",
      "src/middlewares/**/*.js"
    ]
  }
}
