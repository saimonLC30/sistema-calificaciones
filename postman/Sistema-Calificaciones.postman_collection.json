{
  "info": {
    "name": "Sistema de Calificaciones",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección para probar la API.\n\nAntes de empezar: `npm run seed` y `npm run dev`.\n\n1. Corré la carpeta **1. Login**: guarda solos los tokens de admin, docente y alumna.\n2. Seguí las carpetas en orden: cada request guarda los ids que necesita la siguiente.\n3. O corré toda la colección con **Run collection**: cada request tiene tests que muestran ✔ o ✘.\n\nTodos los usuarios del seed tienen la contraseña 123456."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenDocente",
      "value": ""
    },
    {
      "key": "tokenAlumna",
      "value": ""
    },
    {
      "key": "materiaId",
      "value": ""
    },
    {
      "key": "alumnaId",
      "value": ""
    },
    {
      "key": "evaluacionId",
      "value": ""
    },
    {
      "key": "calificacionId",
      "value": ""
    },
    {
      "key": "hoy",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fecha de hoy (AAAA-MM-DD) para crear evaluaciones",
          "pm.collectionVariables.set('hoy', new Date().toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Salud",
      "description": "¿La API responde? ¿MongoDB está conectado?",
      "item": [
        {
          "name": "API funcionando",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Base de datos conectada",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/salud",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('MongoDB conectado', () => pm.expect(pm.response.json().baseDeDatos).to.eql('conectada'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Login",
      "description": "Guarda los tokens en las variables de la colección. Corré esta carpeta primero.",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@mail.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "pm.collectionVariables.set('tokenAdmin', token);",
                  "pm.test('Guardó el token en {{tokenAdmin}}', () => pm.expect(token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login docente (Gómez, Programación II)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gomez@mail.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "pm.collectionVariables.set('tokenDocente', token);",
                  "pm.test('Guardó el token en {{tokenDocente}}', () => pm.expect(token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login alumna (Ana)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@mail.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "pm.collectionVariables.set('tokenAlumna', token);",
                  "pm.test('Guardó el token en {{tokenAlumna}}', () => pm.expect(token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Quién soy (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro público (siempre crea alumno)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Alumno Nuevo\",\n  \"email\": \"nuevo{{$timestamp}}@mail.com\",\n  \"password\": \"123456\",\n  \"rol\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Aunque mande `rol: admin`, el sistema lo registra como alumno."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Ignora el rol y lo crea como alumno', () => pm.expect(pm.response.json().user.rol).to.eql('alumno'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Materias y evaluaciones (docente)",
      "description": "El docente ve sus materias, sus alumnos y crea una evaluación.",
      "item": [
        {
          "name": "Mis materias",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/materias",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const m = pm.response.json().resultados[0];",
                  "pm.collectionVariables.set('materiaId', m._id);",
                  "pm.test('Guardó materiaId', () => pm.expect(m._id).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle de la materia (con alumnos)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/materias/{{materiaId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const ana = pm.response.json().materia.alumnos.find(a => a.email === 'ana@mail.com');",
                  "pm.collectionVariables.set('alumnaId', ana._id);",
                  "pm.test('Guardó alumnaId (Ana)', () => pm.expect(ana._id).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear evaluación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/evaluaciones",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"materia\": \"{{materiaId}}\",\n  \"titulo\": \"Recuperatorio\",\n  \"tipo\": \"recuperatorio\",\n  \"fecha\": \"{{hoy}}\",\n  \"notaMaxima\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('evaluacionId', pm.response.json().evaluacion._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar evaluaciones de la materia",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/evaluaciones?materia={{materiaId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Calificaciones: cargar, publicar y corregir",
      "description": "El caso de uso principal, en orden.",
      "item": [
        {
          "name": "Docente carga la nota (queda pendiente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/calificaciones",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alumno\": \"{{alumnaId}}\",\n  \"evaluacion\": \"{{evaluacionId}}\",\n  \"nota\": 7.5,\n  \"observaciones\": \"Buen trabajo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const c = pm.response.json().calificacion;",
                  "pm.collectionVariables.set('calificacionId', c._id);",
                  "pm.test('Quedó pendiente', () => pm.expect(c.estado).to.eql('pendiente'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alumna: mis calificaciones (todavía NO la ve)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/calificaciones/mis-calificaciones",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumna}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const id = pm.collectionVariables.get('calificacionId');",
                  "pm.test('La nota pendiente no aparece', () => pm.expect(pm.response.json().calificaciones.some(c => c._id === id)).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "Docente publica la nota",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/calificaciones/{{calificacionId}}/estado",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"publicada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Quedó publicada', () => pm.expect(pm.response.json().calificacion.estado).to.eql('publicada'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alumna: mis calificaciones (ahora SÍ la ve)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/calificaciones/mis-calificaciones",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumna}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const id = pm.collectionVariables.get('calificacionId');",
                  "pm.test('La nota publicada aparece', () => pm.expect(pm.response.json().calificaciones.some(c => c._id === id)).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Docente corrige la nota (pasa a revisada)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/calificaciones/{{calificacionId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nota\": 8,\n  \"motivo\": \"Error al sumar el ejercicio 3\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Quedó revisada', () => pm.expect(pm.response.json().calificacion.estado).to.eql('revisada'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Volver a pendiente (no se puede → 409)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/calificaciones/{{calificacionId}}/estado",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"pendiente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle con historial de cambios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/calificaciones/{{calificacionId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar con filtros",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/calificaciones?periodo=2026-2C&estado=publicada&pagina=1&limite=20",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Historial de la alumna + promedios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/calificaciones/alumno/{{alumnaId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Seguridad",
      "description": "Qué pasa cuando alguien intenta algo que no le corresponde.",
      "item": [
        {
          "name": "Sin token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/calificaciones",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token inválido → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/calificaciones",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenTrucho}}",
                  "type": "string"
                }
              ]
            },
            "description": "La variable tokenTrucho no existe: manda un token vacío."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alumna entra a usuarios → 403",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/usuarios",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumna}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alumna intenta cargar una nota → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/calificaciones",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumna}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alumno\": \"{{alumnaId}}\",\n  \"evaluacion\": \"{{evaluacionId}}\",\n  \"nota\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
